// prisma/schema.prisma
// CDU Portal - Nusa Putra University

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // hashed dengan bcrypt
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prodis             Prodi[]            @relation("UserProdis")
  monitoringUpdates  MonitoringSesi[]
  laporanDibuat      LaporCdu[]         @relation("PelaporLaporCdu")
  laporanDiproses    LaporCdu[]         @relation("ProsesLaporCdu")
  notifikasiDibuat   Notification[]     @relation("NotifikasiDibuat")
  notifikasiDiterima Notification[]     @relation("NotifikasiTargetUser")
  notifikasiDibaca   NotificationRead[]
  edlinkCekDiminta   EdlinkCekRequest[]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DOSEN
}

// ─────────────────────────────────────────
// DATA MASTER
// ─────────────────────────────────────────

model Semester {
  id            String    @id @default(cuid())
  tahunAkademik String // contoh: "2024/2025"
  periode       Periode // GANJIL atau GENAP
  aktif         Boolean   @default(false)
  tanggalMulai  DateTime? // Tanggal mulai sesi 1 resmi (misal: 2026-09-21)
  createdAt     DateTime  @default(now())

  kelas            Kelas[]
  hariLibur        LiburSemester[]
  raporDosen       RaporDosen[]
  raporDosenConfig RaporDosenConfig?

  @@unique([tahunAkademik, periode])
}

model LiburSemester {
  id             String   @id @default(cuid())
  semesterId     String
  nama           String // contoh: "Minggu Tenang UTS", "Tahun Baru", "Libur Remedial"
  tanggalMulai   DateTime
  tanggalSelesai DateTime // Jika 1 hari, tanggalSelesai sama dengan tanggalMulai
  keterangan     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@index([semesterId])
}

enum Periode {
  GANJIL
  GENAP
}

model Fakultas {
  id        String   @id @default(cuid())
  nama      String   @unique
  createdAt DateTime @default(now())

  prodi Prodi[]
}

model Prodi {
  id         String   @id @default(cuid())
  nama       String
  kode       String   @unique
  fakultasId String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  fakultas   Fakultas     @relation(fields: [fakultasId], references: [id])
  dosen      Dosen[]
  mataKuliah MataKuliah[]
  users      User[]       @relation("UserProdis")
  laporanCdu LaporCdu[]

  @@index([isActive])
}

model Dosen {
  id        String   @id @default(cuid())
  nama      String
  nidn      String?  @unique
  nip       String?  @unique
  nuptk     String?
  email     String?
  prodiId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prodi                Prodi            @relation(fields: [prodiId], references: [id])
  kelas                Kelas[]          @relation("DosenUtamaKelas")
  kelasTandem          Kelas[]          @relation("DosenTandemKelas")
  monitoringSesiDiajar MonitoringSesi[] @relation("SesiDosenPengajar")
  raporDosen           RaporDosen[]
}

model MataKuliah {
  id        String   @id @default(cuid())
  kode      String
  nama      String
  sks       Int
  prodiId   String
  createdAt DateTime @default(now())

  prodi Prodi   @relation(fields: [prodiId], references: [id])
  kelas Kelas[]

  @@unique([kode, prodiId])
}

model Kelas {
  id               String           @id @default(cuid())
  kodeKelas        String // contoh: TI23I, MN24H
  semesterId       String
  mataKuliahId     String
  dosenId          String
  dosen2Id         String? // Dosen Tandem (opsional)
  jadwalHari       String? // contoh: "Senin"
  jadwalJam        String? // contoh: "10:00 - 11:40"
  ruangan          String? // contoh: "R.204", "Lab Komputer 1" (opsional untuk kelas offline)
  modePembelajaran ModePembelajaran @default(DARING)
  edlinkGroupId    Int?             @unique // ID kelas (group) di Edlink, contoh: 2126659 → https://edlink.id/classes/2126659
  edlinkSyncedAt   DateTime? // Terakhir disinkronkan oleh worker integrasi Edlink
  // Sumber konten LMS kelas. EDLINK = dipantau via edlinkGroupId; NUSAPUTRA_APP = LMS nusaputra.app
  // (prodi non-Edlink, mis. D3 Keperawatan) yang diimpor worker lewat /api/integrasi/kelas/eksternal.
  sumberLms        SumberLms        @default(EDLINK)
  externalId       String?          @unique // UUID course_class di nusaputra.app
  externalUrl      String? // Halaman sesi kelas di LMS nusaputra.app (tombol "Buka di nusaputra.app")
  externalSyncedAt DateTime? // Terakhir disinkronkan dari nusaputra.app
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  semester       Semester           @relation(fields: [semesterId], references: [id])
  mataKuliah     MataKuliah         @relation(fields: [mataKuliahId], references: [id])
  dosen          Dosen              @relation("DosenUtamaKelas", fields: [dosenId], references: [id])
  dosen2         Dosen?             @relation("DosenTandemKelas", fields: [dosen2Id], references: [id])
  monitoringSesi MonitoringSesi[]
  laporanCdu     LaporCdu[]
  edlinkCek      EdlinkCekRequest[]

  @@unique([kodeKelas, semesterId, mataKuliahId])
  @@index([semesterId])
  @@index([mataKuliahId])
  @@index([dosenId])
  @@index([sumberLms])
}

enum ModePembelajaran {
  DARING
  LURING
  HYBRID
  BIMBINGAN
}

// ─────────────────────────────────────────
// MONITORING (Inti Sistem)
// ─────────────────────────────────────────

model MonitoringSesi {
  id        String    @id @default(cuid())
  kelasId   String
  nomorSesi Int // 1–16
  jenisSesi JenisSesi // REGULER, UTS (sesi 8), UAS (sesi 16)
  tanggal   DateTime?

  // ── Kehadiran Dosen ──────────────────────────────────────────────────────
  // Berlaku untuk SEMUA sesi (Reguler, UTS, UAS)
  // Diisi MANUAL oleh CDU Staff - default: BELUM_DIISI
  kehadiran Kehadiran @default(BELUM_DIISI)

  // ── Komponen Konten ───────────────────────────────────────────────────────
  // HANYA untuk sesi REGULER (sesi 1–7 dan 9–15)
  // Sesi 8 (UTS) dan Sesi 16 (UAS) → semua field konten = NULL (tidak berlaku)
  // Nilai: true = ada | false = tidak ada | null = tidak berlaku (UTS/UAS)
  // Diisi OTOMATIS dari import Excel Edlink
  lectureNote Boolean? // Lecture Note / Modul
  slide       Boolean? // Presentasi / PPT / Slide
  video       Boolean? // Video Pembelajaran
  conference  Boolean? // Live Conference / Zoom / Video Conference
  tugas       Boolean? // Tugas / Assignment / Case Study / Project
  kuis        Boolean? // Quiz

  // ── Dosen Pengajar Sesi (Dosen Pengganti / Pergantian Dosen) ─────────────
  dosenPengajarId   String?
  dosenPengajar     Dosen?         @relation("SesiDosenPengajar", fields: [dosenPengajarId], references: [id])
  statusPengajar    StatusPengajar @default(UTAMA)
  catatanGantiDosen String?

  // ── Metadata ──────────────────────────────────────────────────────────────
  catatanCdu  String? // Catatan tambahan dari CDU
  sumberData  SumberData @default(MANUAL)
  inputOlehId String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  kelas     Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  inputOleh User? @relation(fields: [inputOlehId], references: [id])

  @@unique([kelasId, nomorSesi])
  @@index([nomorSesi, kehadiran])
}

enum JenisSesi {
  REGULER // Sesi 1–7, 9–15 → ada kehadiran + konten
  UTS // Sesi 8          → hanya kehadiran, konten NULL
  UAS // Sesi 16         → hanya kehadiran, konten NULL
}

enum Kehadiran {
  HADIR // Hadir
  TIDAK_HADIR // Tidak hadir / Alpha
  HADIR_TIDAK_LENGKAP // Hadir tapi tidak lengkap
  BELUM_DIISI // Default - belum dicek CDU
}

enum SumberData {
  MANUAL // Diisi manual oleh CDU
  IMPORT_EXCEL // Dari import file Edlink
  EDLINK_API // Dari worker integrasi Edlink (otomatis, via /api/integrasi)
  NUSAPUTRA_APP // Dari worker integrasi LMS nusaputra.app (otomatis, via /api/integrasi)
}

enum StatusPengajar {
  UTAMA // Diajar oleh Dosen Utama kelas
  TANDEM // Diajar oleh Dosen Tandem kelas
  PENGGANTI_INSIDENTAL // Menggantikan sementara pada sesi ini (Kasus 1)
  PERGANTIAN_TETAP // Pergantian resmi mulai sesi ini ke depan (Kasus 2)
}

// ─────────────────────────────────────────
// LAPOR CDU (Pusat Pengaduan & Sanggahan)
// ─────────────────────────────────────────

model LaporCdu {
  id        String @id @default(cuid())
  kelasId   String
  nomorSesi Int // Sesi 1 - 16
  prodiId   String
  pelaporId String

  kategori    KategoriLapor
  keterangan  String        @db.Text
  tautanBukti String? // Link Google Drive / Zoom / rekaman (opsional teks)

  status          StatusLapor @default(PENDING) // PENDING, DISETUJUI, DITOLAK
  catatanCdu      String?     @db.Text
  diprosesOlehId  String?
  tanggalDiproses DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kelas        Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  prodi        Prodi @relation(fields: [prodiId], references: [id], onDelete: Cascade)
  pelapor      User  @relation("PelaporLaporCdu", fields: [pelaporId], references: [id], onDelete: Cascade)
  diprosesOleh User? @relation("ProsesLaporCdu", fields: [diprosesOlehId], references: [id], onDelete: SetNull)

  @@index([kelasId, nomorSesi])
  @@index([prodiId])
  @@index([status])
}

enum StatusLapor {
  PENDING
  DISETUJUI
  DITOLAK
}

enum KategoriLapor {
  KEHADIRAN_ALPHA // Seharusnya Hadir tapi tercatat Alpha
  LIVE_CONFERENCE // Sudah Live tapi belum tercentang
  KONTEN_MATERI // Modul/Slide/Tugas belum tercatat
  DOSEN_PENGGANTI // Diajar dosen pengganti belum disesuaikan
  LAINNYA // Kendala teknis lainnya
}

// ─────────────────────────────────────────
// NOTIFIKASI RESMI CDU (Pengumuman & Peringatan)
// ─────────────────────────────────────────

model Notification {
  id              String             @id @default(cuid())
  tipe            NotificationType // PENGUMUMAN atau PERINGATAN
  targetTipe      NotificationTarget // SEMUA, ROLE_DOSEN, PRODI, USER_SPESIFIK
  targetUserId    String?
  targetProdiId   String?
  targetKelasKode String? // Opsional untuk Peringatan terkait kelas tertentu (misal: "TI23I")

  judul     String
  pesan     String              @db.Text
  urgensi   NotificationUrgency @default(PENTING)
  tautanUrl String? // Link opsional (misal: "/monitoring", link panduan, dll)

  isSelesai      Boolean   @default(false)
  kadaluarsaPada DateTime? // Batas waktu tanggal & jam otomatis selesai

  dibuatOlehId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dibuatOleh User               @relation("NotifikasiDibuat", fields: [dibuatOlehId], references: [id], onDelete: Cascade)
  targetUser User?              @relation("NotifikasiTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  pembaca    NotificationRead[]

  @@index([targetTipe])
  @@index([targetUserId])
  @@index([targetProdiId])
  @@index([createdAt])
  @@index([isSelesai])
}

model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
}

enum NotificationType {
  PENGUMUMAN
  PERINGATAN
}

enum NotificationTarget {
  SEMUA
  ROLE_DOSEN
  PRODI
  USER_SPESIFIK
}

enum NotificationUrgency {
  PENTING // Info resmi umum
  PERINGATAN // Perhatian/atensi khusus
  BAHAYA // Teguran pelanggaran mendesak
}

// ─────────────────────────────────────────
// INTEGRASI EDLINK — antrian "Cek dari Edlink"
// ─────────────────────────────────────────
// Tombol di halaman monitoring kelas membuat 1 baris PENDING; worker edlink-sync
// mengambilnya (PROSES), menarik data sesi dari Edlink, mengirim ke /api/integrasi/sesi,
// lalu menandai SELESAI/GAGAL beserta ringkasan hasil.

model EdlinkCekRequest {
  id            String          @id @default(cuid())
  kelasId       String
  status        StatusEdlinkCek @default(PENDING)
  dimintaOlehId String?
  hasil         Json? // ringkasan: { sesiDiperbarui, perubahan, selisihJadwal, ... }
  error         String?
  createdAt     DateTime        @default(now())
  diambilAt     DateTime?
  selesaiAt     DateTime?

  kelas       Kelas @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  dimintaOleh User? @relation(fields: [dimintaOlehId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([kelasId, createdAt])
}

enum StatusEdlinkCek {
  PENDING
  PROSES
  SELESAI
  GAGAL
}

// ─────────────────────────────────────────
// RAPOR DOSEN (Evaluasi Tridharma Dosen QAU & CDU)
// ─────────────────────────────────────────

model RaporDosenConfig {
  id              String   @id @default(cuid())
  semesterId      String   @unique
  bobotKuesioner  Float    @default(40.0) // 40%
  bobotKehadiran  Float    @default(20.0) // 20%
  bobotKonten     Float    @default(20.0) // 20%
  bobotPenelitian Float    @default(10.0) // 10%
  bobotPengabdian Float    @default(10.0) // 10%
  targetSesi      Int      @default(16)   // Minimal 16 pertemuan

  // ── Pengesahan & Tanda Tangan (TTD)
  namaPejabat     String   @default("Dr. Samsul Pahmi, M.Pd.")
  nidnPejabat     String   @default("0403048803")
  jabatanPejabat  String   @default("Kepala Quality Assurance Unit (QAU)")
  kotaTerbit      String   @default("Sukabumi")
  ttdImageUrl     String?  // Data URL base64 atau path file gambar TTD / stempel
  showTtdDigital  Boolean  @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  semester        Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
}

model RaporDosen {
  id                 String           @id @default(cuid())
  dosenId            String
  semesterId         String

  // ── Indikator 1: Kuesioner Mahasiswa (SIAKAD)
  nilaiKuesioner     Float?           // Nilai rerata kuesioner, misal 4.10
  totalResponden     Int?             // Mahasiswa yang mengisi kuesioner
  targetResponden    Int?             // Total mahasiswa di kelas
  skorKuesioner      Float?           // Skala 1.00 - 5.00

  // ── Indikator 2: Kehadiran Mengajar (CDU)
  rerataSesiHadir    Float?           // Rata-rata sesi hadir per kelas, misal 16.0
  persenKehadiran    Float?           // Persentase kehadiran riil, misal 100.0%
  skorKehadiran      Float?           // Skala 1.00 - 5.00

  // ── Indikator 3: Kelengkapan Konten LMS (CDU 3 Pilar)
  persenKonten       Float?           // Persentase 3 pilar, misal 68.0%
  skorKonten         Float?           // Skala 1.00 - 5.00

  // ── Indikator 4: Penelitian (LPPM / Input QAU)
  jumlahPenelitian   Int              @default(0) // Jumlah publikasi/penelitian
  skorPenelitian     Float?           // 0: 3.20 | 1: 3.88 | 2: 4.35 | >=3: 5.00

  // ── Indikator 5: Pengabdian Masyarakat (LPPM / Input QAU)
  jumlahPengabdian   Int              @default(0) // Jumlah kegiatan PkM
  skorPengabdian     Float?           // 0: 3.20 | 1: 3.88 | 2: 4.35 | >=3: 5.00

  // ── Skor Akhir & Predikat
  nilaiAkhir         Float?           // Total terbobot skala 1.00 - 5.00, misal 4.41
  predikat           String?          // SANGAT_BAIK, BAIK, CUKUP, KURANG_BAIK, KURANG

  // ── Bagian C: Rekomendasi Perbaikan (P1 - P5)
  // Array JSON string: ["Mengenal dengan baik mahasiswa...", ...]
  rekomendasiPerbaikan Json?

  // ── Bagian D: Catatan Kritik & Saran Mahasiswa (K1 - K5)
  // Array JSON string: ["terlalu cepat dalam menyampaikan materi...", ...]
  komentarMahasiswa    Json?

  // ── Arsip Seluruh Komentar Mentah Mahasiswa dari Kuesioner SIAKAD
  rawKomentarMahasiswa Json?

  // ── Bagian E: Analisis Sentimen Mahasiswa & Kesimpulan
  responPositifCount Int?             // misal: 90
  responNetralCount  Int?             // misal: 13
  responNegatifCount Int?             // misal: 7
  responPositifPct   Float?           // misal: 81.8
  responNetralPct    Float?           // misal: 11.8
  responNegatifPct   Float?           // misal: 6.4
  narasiKesimpulan   String?          @db.Text

  // ── Metadata & Status
  statusRapor        StatusRaporDosen @default(DRAFT)
  sumberImport       String?          // Nama file sumber import, misal "laporan_rekap_angket.xls"
  catatanQau         String?          @db.Text
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  dosen              Dosen            @relation(fields: [dosenId], references: [id], onDelete: Cascade)
  semester           Semester         @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@unique([dosenId, semesterId])
  @@index([semesterId])
  @@index([dosenId])
  @@index([predikat])
}

enum StatusRaporDosen {
  DRAFT
  FINAL

}

enum SumberLms {
  EDLINK // Konten dipantau dari Edlink
  NUSAPUTRA_APP // Konten dipantau dari LMS nusaputra.app
}
